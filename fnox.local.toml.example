# Copy to fnox.local.toml (git-ignored, never commit it). It overrides fnox.toml on this machine.
#
# Top level: SECRETS only. Every profile inherits them.
[secrets]
YOUTUBE_API_KEY = { default = "your_youtube_api_key_here" }   # mise run local:apikey:setup writes it
GEMINI_API_KEY = { default = "your_gemini_api_key_here" }     # mise run local:apikey:gemini writes it

# Your own SETTINGS go in the `overrides` profile (mise run local:method:set writes it), applied last on top of the
# profiles you pick with `mise run local:profile:use -- ytdlp gemini-lite`. Never put a setting at the top level:
# it would silently beat every profile.
# [profiles.overrides.secrets]
# TRANSCRIPT_METHOD = { default = "ytdlp" }

# The one profile that holds secrets: your Webshare proxy, used only when you pick it (`local:profile:use -- ytdlp
# proxy`). `mise run local:proxy:setup` asks for the username and password, tests YouTube through it and writes this.
# By hand: type only the two lines below (the username WITHOUT "-rotate"), then run `mise run local:proxy:setup --
# --check`: it tests them and adds (or refreshes) the PROXY_URL line for you.
# [profiles.proxy.secrets]
# WEBSHARE_PROXY_USERNAME = { default = "your_proxy_username" }
# WEBSHARE_PROXY_PASSWORD = { default = "your_proxy_password" }
# PROXY_URL = { default = "http://your_proxy_username-rotate:your_proxy_password@p.webshare.io:80/" }

# YouTube login cookies for yt-dlp, used only when you pick the `cookies` profile. `mise run local:cookies:setup` collects them
# into a file OUTSIDE the repo and writes this. The file is a login: never put it in the repository.
# [profiles.cookies.secrets]
# YTDLP_COOKIES_FILE = { default = "/Users/you/.config/seeker/youtube-cookies.txt" }
