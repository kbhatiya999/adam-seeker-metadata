# Copy to fnox.local.toml (git-ignored, never commit it). It overrides fnox.toml on this machine.
#
# Secrets do NOT belong here any more: they are encrypted in fnox.toml (mise run local:apikey:setup, local:apikey:gemini,
# local:proxy:setup, local:cookies:setup write them there; see README_AUTOMATION.md "Encrypted secrets"). If you still
# have plain values here, `mise run local:secrets:migrate` moves them into fnox.toml, encrypted.

# Your own SETTINGS go in the `overrides` profile (mise run local:method:set writes it), applied last on top of the
# profiles you pick with `mise run local:profile:use -- ytdlp gemini-lite`. Never put a setting at the top level:
# it would silently beat every profile.
# [profiles.overrides.secrets]
# TRANSCRIPT_METHOD = { default = "ytdlp" }

# The proxy by hand (instead of `mise run local:proxy:setup`): type these two lines (the username WITHOUT "-rotate"),
# then `mise run local:secrets:migrate` (encrypts them into fnox.toml and removes them here) and
# `mise run local:proxy:setup -- --check` (tests them and adds the encrypted PROXY_URL).
# [profiles.proxy.secrets]
# WEBSHARE_PROXY_USERNAME = { default = "your_proxy_username" }
# WEBSHARE_PROXY_PASSWORD = { default = "your_proxy_password" }
